{
  "expo": {
    "name": "Speakora",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "speakora",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#312E81"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Speakora to access your microphone for AI speaking practice."
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#312E81"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#312E81",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false,
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#312E81"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#312E81",
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "imageWidth": 300
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Speakora to access your microphone for AI speaking practice."
        }
      ]
    ],
    "extra": {
      "googleWebClientId": "324340379317-nm9bnfb8nop5ch7v7qcds73ut2gppcgd.apps.googleusercontent.com"
    }
  }
}
