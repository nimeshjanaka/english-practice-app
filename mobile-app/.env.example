# Backend API base URL (no trailing slash). Required by the mobile app.
# Simulator / web can use localhost:
EXPO_PUBLIC_API_URL=http://localhost:8000
#
# On a physical phone, localhost is rewritten to your Expo LAN IP automatically.
# Or set your Mac LAN IP explicitly:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Optional Google Sign-In web client id
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
