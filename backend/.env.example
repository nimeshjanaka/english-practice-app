# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env — only commit .env.example.

# PostgreSQL connection URL
# Local (Homebrew, no password):
#   postgresql://YOUR_MAC_USERNAME@localhost:5432/englishapp
# Cloud (Supabase / Neon) — include sslmode=require:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://nimeshjanaka@localhost:5432/englishapp

# Groq API key (Whisper STT, Llama chat, PlayAI TTS) — https://console.groq.com/keys
GROQ_API_KEY=
# Chat model your Groq org can access (default works on most free tiers)
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# OpenAI key for GPT-4o lesson generation — https://platform.openai.com/api-keys
# Voice chat uses Groq. Keep this file as the template and put the real key in .env.
OPENAI_API_KEY=

# JWT settings — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=60

# Local/dev: return reset_token in forgot-password response (no email needed)
DEBUG_AUTH=true

# Google Sign-In — OAuth 2.0 Web client ID
GOOGLE_CLIENT_ID=
